#!/bin/sh
# Pitato from its SD card image, the first time it starts: the game folders for the games this Pi plays (a Pi 4 or 5
# plays N64, PSP and DS games too), in the Games folder of the pitato folder's owner. Then never again.
root="${PITATO_ROOT:-}"                        # (for its tests: a pretend /)
model=$(tr -d '\0' < "${PITATO_MODEL_FILE:-/proc/device-tree/model}" 2> /dev/null)
for static in "$root"/home/*/pitato/static; do
  [ -d "$static" ] || continue
  folder=${static%/static}
  home=${folder%/pitato}
  owner=$(stat -c %u:%g "$folder")
  case "$model" in
    *"Pi 4"*|*"Pi 5"*|*"Compute Module 4"*|*"Compute Module 5"*)
      for sys in n64 psp nds; do
        if [ -d "$home/Games" ] && [ ! -e "$home/Games/$sys" ]; then
          mkdir "$home/Games/$sys" && chown "$owner" "$home/Games/$sys"
        fi
      done ;;
  esac
  break
done
mkdir -p "$root/var/lib/pitato" && touch "$root/var/lib/pitato/image-firstboot-done"
