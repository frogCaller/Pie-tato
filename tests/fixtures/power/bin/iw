#!/bin/sh
# A pretend iw: Wi-Fi's power saving, kept in $FAKE_IW_STATE ("off" to start); each change put down in $FAKE_IW_LOG.
state="${FAKE_IW_STATE:-/nonexistent}"
if [ "$1" = dev ] && [ "$3" = get ] && [ "$4" = power_save ]; then
  echo "Power save: $(cat "$state" 2>/dev/null || echo off)"
elif [ "$1" = dev ] && [ "$3" = set ] && [ "$4" = power_save ]; then
  echo "$5" > "$state"
  echo "$2 $5" >> "${FAKE_IW_LOG:-/dev/null}"
fi
