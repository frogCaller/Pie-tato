#!/usr/bin/env python3
"""Fails once with 'Device or resource busy' (as when the previous ffmpeg hasn't let go yet)."""
import os, sys
mark = os.environ["BUSY_ONCE"]
if "v4l2" in sys.argv and os.path.exists(mark):
    os.remove(mark)
    sys.stderr.write("[video4linux2,v4l2 @ 0x1] ioctl(VIDIOC_STREAMON): Device or resource busy\n/dev/video0: Device or resource busy\n")
    sys.exit(1)
os.execv(os.environ["REAL_FAKE"], ["ffmpeg"] + sys.argv[1:])
