-		// Only attempt to establish the connection every 5 seconds
-		if (((now - lastConnectAttempt_) / CLOCKS_PER_SEC) < 5) {
+		// Only attempt to establish the connection every so often: a quarter of a second for a server that's
+		// listening (taking a client that's there waits for nothing), 2 seconds otherwise
+		if (nowMs() - lastConnectAttempt_ < (is_server_ && server_fd_ >= 0 ? 250 : 2000)) {
 			return false;
 		}
 	}
-	lastConnectAttempt_ = clock();
+	lastConnectAttempt_ = nowMs();
 	if (is_server_) {
 		if (!startServerSocket()) {
 			return false;
@@ -103,6 +118,11 @@ bool NetSerial::startServerSocket()
 			gambatte_log(RETRO_LOG_ERROR, "Error opening socket: %s\n", strerror(errno));
 			return false;
 		}
+#ifndef _WIN32
+		// Its port again straight after the last time (its old connection, still closing, doesn't keep it)
+		int one = 1;
+		setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+#endif
 
 		if (bind(fd, (struct sockaddr *)&server_addr, sizeof(server_addr)) < 0) {
 			gambatte_log(RETRO_LOG_ERROR, "Error on binding: %s\n", strerror(errno));
@@ -175,7 +195,30 @@ bool NetSerial::startClientSocket()
 		}
 
 		memmove((char*)&server_addr.sin_addr.s_addr, (char*)server_hostname->h_addr, server_hostname->h_length);
+#ifndef _WIN32
+		// A second at most (a server that's gone would keep the game waiting for minutes)
+		int flags = fcntl(fd, F_GETFL, 0);
+		fcntl(fd, F_SETFL, flags | O_NONBLOCK);
+		int rc = connect(fd, (struct sockaddr*)&server_addr, sizeof(server_addr));
+		if (rc < 0 && errno == EINPROGRESS) {
+			fd_set wfds;
+			struct timeval tv;
+			FD_ZERO(&wfds);
+			FD_SET(fd, &wfds);
+			tv.tv_sec = 1;
+			tv.tv_usec = 0;
+			int err = ETIMEDOUT;
+			socklen_t len = sizeof(err);
+			if (select(fd + 1, NULL, &wfds, NULL, &tv) > 0)
+				getsockopt(fd, SOL_SOCKET, SO_ERROR, &err, &len);
+			rc = err ? -1 : 0;
+			errno = err;
+		}
+		fcntl(fd, F_SETFL, flags);
+		if (rc < 0) {
+#else
 		if (connect(fd, (struct sockaddr*)&server_addr, sizeof(server_addr)) < 0) {
+#endif
 			gambatte_log(RETRO_LOG_ERROR, "Error connecting to server: %s\n", strerror(errno));
 			close(fd);
 			return false;
