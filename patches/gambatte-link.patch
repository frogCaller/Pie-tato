+// Milliseconds, of real time (clock() is the time the CPU spent on this program: a game that needs little of it
+// waited minutes to link up)
+static long long nowMs()
+{
+#ifdef _WIN32
+	return (long long)clock() * 1000 / CLOCKS_PER_SEC;
+#else
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (long long)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+#endif
+}
+
 NetSerial::NetSerial()
 : is_stopped_(true)
 , is_server_(false)
